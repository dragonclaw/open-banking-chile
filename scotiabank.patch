+async function logoutScotiabank(page: Page, debugLog: string[]): Promise<void> {
+  try {
+    const clicked = await page.evaluate(() => {
+      for (const element of Array.from(
+        document.querySelectorAll("a, button, span, div, li"),
+      )) {
+        const text = (element as HTMLElement).innerText?.trim().toLowerCase();
+        if (
+          [
+            "cerrar sesión",
+            "cerrar sesion",
+            "salir",
+            "logout",
+            "sign out",
+          ].includes(text)
+        ) {
+          (element as HTMLElement).click();
+          return true;
+        }
+      }
+      return false;
+    });
+    if (clicked) {
+      debugLog.push("  Logged out successfully");
+      await delay(2_000);
+    }
+  } catch {
+    // Closing the isolated browser context also ends the session.
+  }
+}
