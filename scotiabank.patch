+    .allTextContents()
+    .catch(() => []);
+  const pattern =
+    /(error|incorrect|inv[aá]lid|rechazad|bloquead|fall[oó]|credencial|autentic|clave|rut)/i;
+  return (
+    messages
+      .find((message) => {
+        const text = message.trim();
+        return text.length >= 4 && text.length <= 250 && pattern.test(text);
+      })
+      ?.trim() ?? null
+  );
+}
