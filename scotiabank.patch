+async function runScotiabankPlaywright(
+  options: ScraperOptions,
+): Promise<ScrapeResult> {
+  const bank = "scotiabank";
+  if (!options.rut || !options.password) {
+    return {
+      accounts: [],
+      bank,
+      error: "Debes proveer RUT y clave.",
+      success: false,
+    };
+  }
+  if (options.signal?.aborted) {
+    return {
+      accounts: [],
+      bank,
+      error: SCRAPE_CANCELLED_MESSAGE,
+      success: false,
+    };
+  }
+
+  let session: ScotiabankSession | undefined;
+  const closeBrowserOnAbort = (): void => {
+    if (session) {
+      void closeScotiabankBrowser(session);
+    }
+  };
+  try {
+    session = await launchScotiabankPlaywright(options);
+    options.signal?.addEventListener("abort", closeBrowserOnAbort, {
+      once: true,
+    });
+    if (options.signal?.aborted) {
+      closeBrowserOnAbort();
+      return {
+        accounts: [],
+        bank,
+        debug: session.debugLog.join("\n"),
+        error: SCRAPE_CANCELLED_MESSAGE,
+        success: false,
+      };
+    }
+    const result = await scrapeScotiabank(session, options);
+    return options.signal?.aborted
+      ? {
+          accounts: [],
+          bank,
+          debug: session.debugLog.join("\n"),
+          error: SCRAPE_CANCELLED_MESSAGE,
+          success: false,
+        }
+      : result;
+  } catch (error) {
+    if (options.signal?.aborted) {
+      return {
+        accounts: [],
+        bank,
+        error: SCRAPE_CANCELLED_MESSAGE,
+        success: false,
+      };
+    }
+    return {
+      accounts: [],
+      bank,
+      debug: session?.debugLog.join("\n"),
+      error: `Error del scraper: ${error instanceof Error ? error.message : String(error)}`,
+      success: false,
+    };
+  } finally {
+    options.signal?.removeEventListener("abort", closeBrowserOnAbort);
+    if (session) {
+      await logoutScotiabank(session.page, session.debugLog);
+      await closeScotiabankBrowser(session);
+    }
+  }
+}
