+async function closeScotiabankBrowser(
+  session: ScotiabankSession,
+): Promise<void> {
+  try {
+    const cdpSession = await session.context.newCDPSession(session.page);
+    await cdpSession.send("Browser.close");
+  } catch {
+    await session.browser.close().catch(() => {});
+  } finally {
+    session.browserProcess.kill();
+    session.relayProcess?.kill();
+  }
+}
