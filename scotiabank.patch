+
+export function resolveScotiabankProfileDirectory(
+  executablePath: string,
+  configuredDirectory?: string,
+): string {
+  const windowsExecutable = executablePath.match(WINDOWS_EXECUTABLE_PATTERN);
+  if (!windowsExecutable) {
+    return path.resolve(
+      configuredDirectory || path.join(".browser-profiles", "scotiabank"),
+    );
+  }
+
+  if (configuredDirectory && /^[a-z]:[\\/]/i.test(configuredDirectory)) {
+    return configuredDirectory.replaceAll("/", "\\");
+  }
+
+  if (configuredDirectory) {
+    const mountedPath = path
+      .resolve(configuredDirectory)
+      .match(/^\/mnt\/([a-z])\/(.*)$/i);
+    if (mountedPath) {
+      return `${mountedPath[1]?.toUpperCase()}:\\${mountedPath[2]?.replaceAll("/", "\\")}`;
+    }
+  }
+
+  const drive = windowsExecutable[1]?.toUpperCase() ?? "C";
+  const username = path.basename(homedir());
+  return `${drive}:\\Users\\${username}\\AppData\\Local\\open-banking-chile\\scotiabank`;
+}
+
+export function resolveWslWindowsHost(
+  routeTable = fs.readFileSync("/proc/net/route", "utf8"),
+): string {
+  const defaultRoute = routeTable
+    .split("\n")
+    .map((line) => line.trim().split(/\s+/))
+    .find((columns) => columns[1] === "00000000" && columns[2]?.length === 8);
+  const gatewayHex = defaultRoute?.[2];
+  if (!gatewayHex) {
+    throw new Error("No se pudo resolver la IP de Windows desde WSL2.");
+  }
+  const octets = gatewayHex.match(/.{2}/g)?.reverse();
+  if (!octets) {
+    throw new Error("La ruta predeterminada de WSL2 no es válida.");
+  }
+  return octets.map((octet) => Number.parseInt(octet, 16)).join(".");
+}
+
+function launchWslWindowsTcpRelay(
+  relayPort: number,
+  targetPort: number,
+): ChildProcess {
+  const powershellPath =
+    "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe";
+  const script = [
+    `$listener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Any,${relayPort})`,
+    "$listener.Start()",
+    "while($true){",
+    "$client=$listener.AcceptTcpClient()",
+    "$target=[Net.Sockets.TcpClient]::new()",
+    `try{$target.Connect([Net.IPAddress]::Loopback,${targetPort})`,
+    "$left=$client.GetStream()",
+    "$right=$target.GetStream()",
+    "$a=$left.CopyToAsync($right)",
+    "$b=$right.CopyToAsync($left)",
+    "[Threading.Tasks.Task]::WaitAny(@($a,$b))|Out-Null",
+    "}finally{$client.Dispose();$target.Dispose()}",
+    "}",
+  ].join(";");
+  return spawn(
+    powershellPath,
+    ["-NoProfile", "-NonInteractive", "-Command", script],
+    { stdio: "ignore" },
+  );
+}
+
+export function normalizeScotiabankFingerprint(encoded: string): string {
+  try {
+    const fingerprint = JSON.parse(
+      Buffer.from(encoded, "base64").toString("utf8"),
+    ) as Record<string, unknown>;
+    const browser = getRecord(fingerprint.Browser);
+    const general = getRecord(fingerprint.General);
+    const personalization = getRecord(fingerprint.Personalization);
+    if (!browser || !general || !personalization) return encoded;
+
+    Object.assign(browser, {
+      browserMajor: "152",
+      browserVersion: SCOTIABANK_CHROME_VERSION,
+      osName: "Windows",
+      osVersion: "10",
+      userAgent:
+        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 " +
+        "(KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36",
+    });
+    Object.assign(general, {
+      availableResolution: "1920x1032",
+      deviceMemory: "32",
+      hardwareConcurrency: "16",
+      language: "en-CL",
+      navigatorPlatform: "Win32",
+      rendererVideo: SCOTIABANK_WINDOWS_RENDERER,
+      resolution: "1920x1080",
+      vendorWebGL: "1",
+    });
+    Object.assign(personalization, { numberFonts: "33", numberPlugins: "5" });
+    return Buffer.from(JSON.stringify(fingerprint), "utf8").toString("base64");
+  } catch {
+    return encoded;
+  }
+}
+
+function getRecord(value: unknown): Record<string, unknown> | null {
+  return value && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : null;
+}
+
+async function installScotiabankFingerprintRoute(page: Page): Promise<void> {
+  await page.route(`**${AUTH_CALLBACK_PATH}`, async (route) => {
+    const request = route.request();
+    const postData = request.postData();
+    if (!postData) {
+      await route.continue();
+      return;
+    }
+    const form = new URLSearchParams(postData);
+    const fingerprint = form.get("xFingerPrintDevice");
+    if (!fingerprint) {
+      await route.continue();
+      return;
+    }
+    form.set("xFingerPrintDevice", normalizeScotiabankFingerprint(fingerprint));
+    await route.continue({ postData: form.toString() });
+  });
+}
+
+async function reserveLocalPort(): Promise<number> {
+  return await new Promise((resolve, reject) => {
+    const server = createServer();
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      const address = server.address();
+      if (!address || typeof address === "string") {
+        server.close();
+        reject(new Error("No se pudo reservar un puerto local para Chrome."));
+        return;
+      }
+      server.close((error) => (error ? reject(error) : resolve(address.port)));
+    });
+  });
+}
+
+async function waitForChromeDebugEndpoint(
+  endpoint: string,
+  browserProcess: ChildProcess,
+  relayProcess?: ChildProcess,
+): Promise<void> {
+  const deadline = Date.now() + 15_000;
+  while (Date.now() < deadline) {
+    if (browserProcess.exitCode !== null && !relayProcess) {
+      throw new Error(
+        `Chrome terminó antes de iniciar (HTTP ${browserProcess.exitCode}).`,
+      );
+    }
+    if (
+      relayProcess?.exitCode !== null &&
+      relayProcess?.exitCode !== undefined
+    ) {
+      browserProcess.kill();
+      throw new Error(
+        "El puente local entre WSL2 y Chrome terminó antes de iniciar.",
+      );
+    }
+    const ready = await fetch(`${endpoint}/json/version`)
+      .then((response) => response.ok)
+      .catch(() => false);
+    if (ready) return;
+    await delay(200);
+  }
+  browserProcess.kill();
+  relayProcess?.kill();
+  throw new Error("Chrome no habilitó el canal local de depuración.");
+}
